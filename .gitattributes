# Force LF line endings for all files in the repo
# This prevents CRLF issues when Windows users edit files
* text=auto eol=lf

# Explicitly LF for these file types
*.js    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.json  text eol=lf
*.sql   text eol=lf
*.md    text eol=lf
*.env   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
Dockerfile text eol=lf

# Binary files — no line ending conversion
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
