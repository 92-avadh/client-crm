# ─── Server ──────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production

# ─── Database ────────────────────────────────────────────────────
# Postgres connection string (Render/Neon/Supabase/RDS)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Auth ────────────────────────────────────────────────────────
# REQUIRED in production. Minimum 32 characters.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ─── CORS ────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins. REQUIRED in production.
# Without this, only localhost is allowed and the deployed frontend is blocked.
# Wildcards are supported: https://*.workers.dev
CORS_ORIGINS=https://your-frontend.example.com

# ─── Email / SMTP (for OTP verification) ─────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourapp@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Retentio <noreply@yourdomain.com>"

# Only set to true if your mail server uses a self-signed certificate.
# Enabling this disables TLS MITM protection.
SMTP_ALLOW_SELF_SIGNED=false

# ─── Keep-alive (Render free tier) ───────────────────────────────
RENDER_EXTERNAL_URL=https://your-backend.onrender.com

# ─── Web Push & Device Notifications ─────────────────────────────
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:support@retentio.app
